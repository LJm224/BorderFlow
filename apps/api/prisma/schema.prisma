generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  WAREHOUSE
  ANALYST
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  OFFLINE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PICKING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum Currency {
  USD
  EUR
  GBP
  CNY
}

enum InventoryTransactionType {
  SALE
  RESTOCK
  RESERVATION
  RELEASE
  ADJUSTMENT
}

enum AiRunStatus {
  IDLE
  RUNNING
  VALIDATING
  WAITING_APPROVAL
  SAVING
  COMPLETED
  FAILED
}

model Tenant {
  id              String   @id @default(uuid())
  name            String
  defaultCurrency Currency @default(USD)
  defaultTimezone String   @default("UTC")
  createdAt       DateTime @default(now())
  users           User[]
  products        Product[]
  orders          Order[]
  aiRuns          AiGenerationRecord[]
  auditLogs       AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  aiRuns       AiGenerationRecord[]
  auditLogs    AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Product {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  description String
  market      String
  currency    Currency
  status      ProductStatus  @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  skus        Sku[]
  aiRuns      AiGenerationRecord[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Sku {
  id                    String                  @id @default(uuid())
  productId             String
  skuCode               String
  variantName           String
  price                 Decimal                 @db.Decimal(18, 2)
  costPrice             Decimal                 @db.Decimal(18, 2)
  weight                Decimal                 @db.Decimal(12, 3)
  product               Product                 @relation(fields: [productId], references: [id])
  orderItems            OrderItem[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]

  @@unique([productId, skuCode])
  @@index([skuCode])
}

model Order {
  id              String      @id @default(uuid())
  tenantId        String
  orderNo         String
  market          String
  currency        Currency
  totalAmount     Decimal     @db.Decimal(18, 2)
  status          OrderStatus @default(PENDING_PAYMENT)
  shippingCountry String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  items           OrderItem[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  skuId     String
  quantity  Int
  unitPrice Decimal @db.Decimal(18, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  sku       Sku     @relation(fields: [skuId], references: [id])
}

model Inventory {
  id                String   @id @default(uuid())
  skuId             String
  warehouse         String
  availableQuantity Int
  lockedQuantity    Int      @default(0)
  alertThreshold    Int      @default(0)
  updatedAt         DateTime @updatedAt
  sku               Sku      @relation(fields: [skuId], references: [id])

  @@unique([skuId, warehouse])
  @@index([warehouse])
}

model InventoryTransaction {
  id          String                    @id @default(uuid())
  skuId       String
  type        InventoryTransactionType
  quantity    Int
  referenceId String?
  reason      String?
  createdAt   DateTime                  @default(now())
  sku         Sku                       @relation(fields: [skuId], references: [id])

  @@index([skuId, createdAt])
}

model AiGenerationRecord {
  id            String      @id @default(uuid())
  tenantId      String
  productId     String
  userId        String
  market        String
  inputJson     Json
  outputJson    Json?
  status        AiRunStatus @default(IDLE)
  promptVersion String
  durationMs    Int?
  createdAt     DateTime    @default(now())
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}
