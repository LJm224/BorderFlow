generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  WAREHOUSE
  ANALYST
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  OFFLINE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PICKING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum Currency {
  USD
  EUR
  GBP
  CNY
}

enum InventoryTransactionType {
  SALE
  RESTOCK
  RESERVATION
  RELEASE
  ADJUSTMENT
}

enum InventoryAllocationStatus {
  RESERVED
  FULFILLED
  RELEASED
}

enum AiRunStatus {
  IDLE
  RUNNING
  VALIDATING
  WAITING_APPROVAL
  SAVING
  COMPLETED
  FAILED
}

enum ChannelType {
  SHOPIFY
  AMAZON
  SHOPLINE
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SyncRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
}

model Tenant {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  defaultCurrency Currency @default(USD)
  defaultTimezone String   @default("UTC")
  createdAt       DateTime @default(now())
  users           User[]
  stores          Store[]
  products        Product[]
  orders          Order[]
  aiRuns          AiGenerationRecord[]
  auditLogs       AuditLog[]
  connections     ChannelConnection[]
}

model Store {
  id              String        @id @default(uuid())
  tenantId        String
  name            String
  channelType     ChannelType
  defaultCurrency Currency      @default(USD)
  timezone        String        @default("UTC")
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  orders          Order[]
  warehouses      Warehouse[]
  connections     ChannelConnection[]

  @@unique([tenantId, name])
  @@index([tenantId, channelType])
}

model Warehouse {
  id          String      @id @default(uuid())
  storeId     String
  name        String
  createdAt   DateTime    @default(now())
  store       Store       @relation(fields: [storeId], references: [id])
  inventories Inventory[]

  @@unique([storeId, name])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  aiRuns       AiGenerationRecord[]
  auditLogs    AuditLog[]
  timelineEvents OrderTimelineEvent[]
  inventoryTransactions InventoryTransaction[]
  refreshSessions RefreshSession[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Product {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  description String
  market      String
  currency    Currency
  status      ProductStatus  @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  skus        Sku[]
  aiRuns      AiGenerationRecord[]
  marketContents ProductMarketContent[]
  media       ProductMedia[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model ProductMarketContent {
  id           String        @id @default(uuid())
  productId    String
  market       String
  locale       String
  title        String?
  bulletPoints Json?
  description  String?
  keywords     Json?
  status       ProductStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  product      Product       @relation(fields: [productId], references: [id])

  @@unique([productId, market, locale])
  @@index([market, locale, status])
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String
  url       String
  mediaType MediaType @default(IMAGE)
  altText   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
}

model Sku {
  id                    String                  @id @default(uuid())
  productId             String
  skuCode               String
  variantName           String
  price                 Decimal                 @db.Decimal(18, 2)
  costPrice             Decimal                 @db.Decimal(18, 2)
  weight                Decimal                 @db.Decimal(12, 3)
  product               Product                 @relation(fields: [productId], references: [id])
  orderItems            OrderItem[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]

  @@unique([productId, skuCode])
  @@index([skuCode])
}

model Order {
  id              String      @id @default(uuid())
  tenantId        String
  storeId         String
  orderNo         String
  market          String
  currency        Currency
  totalAmount     Decimal     @db.Decimal(18, 2)
  status          OrderStatus @default(PENDING_PAYMENT)
  shippingCountry String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  store           Store       @relation(fields: [storeId], references: [id])
  items           OrderItem[]
  timelineEvents  OrderTimelineEvent[]
  inventoryAllocations InventoryAllocation[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model OrderTimelineEvent {
  id           String      @id @default(uuid())
  orderId      String
  fromStatus   OrderStatus?
  toStatus     OrderStatus?
  eventType    String
  note         String?
  actorUserId  String?
  createdAt    DateTime    @default(now())
  order        Order       @relation(fields: [orderId], references: [id])
  actor        User?       @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  skuId     String
  quantity  Int
  unitPrice Decimal @db.Decimal(18, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  sku       Sku     @relation(fields: [skuId], references: [id])
  inventoryAllocations InventoryAllocation[]
}

model Inventory {
  id                String   @id @default(uuid())
  skuId             String
  warehouseId       String
  availableQuantity Int
  lockedQuantity    Int      @default(0)
  alertThreshold    Int      @default(0)
  updatedAt         DateTime @updatedAt
  sku               Sku      @relation(fields: [skuId], references: [id])
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  transactions      InventoryTransaction[]
  allocations       InventoryAllocation[]

  @@unique([skuId, warehouseId])
  @@index([warehouseId])
}

model InventoryTransaction {
  id               String                    @id @default(uuid())
  skuId            String
  inventoryId      String?
  actorUserId      String?
  type             InventoryTransactionType
  quantity         Int
  referenceId      String?
  reason           String?
  beforeAvailable  Int?
  afterAvailable   Int?
  beforeLocked     Int?
  afterLocked      Int?
  createdAt        DateTime                  @default(now())
  sku              Sku                       @relation(fields: [skuId], references: [id])
  inventory        Inventory?                @relation(fields: [inventoryId], references: [id])
  actor            User?                     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([skuId, createdAt])
  @@index([inventoryId, createdAt])
}

model InventoryAllocation {
  id          String                   @id @default(uuid())
  orderId     String
  orderItemId String
  inventoryId String
  quantity    Int
  status      InventoryAllocationStatus @default(RESERVED)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  order       Order                    @relation(fields: [orderId], references: [id])
  orderItem   OrderItem                @relation(fields: [orderItemId], references: [id])
  inventory   Inventory                @relation(fields: [inventoryId], references: [id])

  @@index([orderId, status])
  @@index([orderItemId, status])
  @@index([inventoryId, status])
}

model AiGenerationRecord {
  id            String      @id @default(uuid())
  tenantId      String
  productId     String
  userId        String
  market        String
  inputJson     Json
  outputJson    Json?
  status        AiRunStatus @default(IDLE)
  promptVersion String
  durationMs    Int?
  createdAt     DateTime    @default(now())
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

model ChannelConnection {
  id              String           @id @default(uuid())
  tenantId        String
  storeId         String
  channelType     ChannelType
  externalStoreId String?
  status          ConnectionStatus @default(DISCONNECTED)
  lastSyncedAt    DateTime?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  store           Store            @relation(fields: [storeId], references: [id])
  syncRuns        ChannelSyncRun[]

  @@unique([storeId, channelType])
  @@index([tenantId, status])
}

model ChannelSyncRun {
  id           String          @id @default(uuid())
  connectionId String
  status       SyncRunStatus   @default(RUNNING)
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  totalItems   Int             @default(0)
  successItems Int             @default(0)
  failedItems  Int             @default(0)
  connection   ChannelConnection @relation(fields: [connectionId], references: [id])
  logs         ChannelSyncLog[]

  @@index([connectionId, startedAt])
}

model ChannelSyncLog {
  id          String        @id @default(uuid())
  syncRunId   String
  resource    String
  resourceId  String?
  status      String
  errorCode   String?
  message     String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  syncRun     ChannelSyncRun @relation(fields: [syncRunId], references: [id])

  @@index([syncRunId, status])
}
